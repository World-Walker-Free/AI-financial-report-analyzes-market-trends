# 复制本文件为 .env.local（已在 .gitignore 中，不会进 Git）
# 改完必须重启 npm run serve 才生效
#
# 数据源三态：
#   mock  → D1~D2，读 src/mock/dashboard.js，不等任何人（默认）
#   api   → D3 起，经 vue.config.js 代理到 C 的 FastAPI
#   planb → 后端没做完时，读 public/mock/dashboard.json
VUE_APP_DATA_SOURCE=mock

# C 给后端地址后填这里，vue.config.js 会用它做代理 target
# 例：http://127.0.0.1:8000 或 http://192.168.1.20:8000
VUE_APP_API_TARGET=http://127.0.0.1:8000

# Mock 最小响应延迟（毫秒），让加载骨架和「加载中…」真的看得见
# 默认 400；设 0 可关掉。仅 mock 生效，不影响 D3 的真实接口
VUE_APP_MOCK_DELAY=400

# D2 验收专用：改成 1 时所有 Mock 返回空数据，用来验「空数据不白屏」
# ⚠️ 验完务必改回 0 并重启，别带着它进 D3 联调
VUE_APP_FORCE_EMPTY=0

# D2 验收专用：填接口名（逗号分隔），让它们模拟抛错，验「部分挂了其它照常渲染」
# 例：VUE_APP_FAIL_ONE=/views,/ranking
# ⚠️ 验完清空并重启，别带着它进 D3 联调
VUE_APP_FAIL_ONE=
